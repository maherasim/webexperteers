Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block internal folders and sensitive files
  RewriteRule ^(app|storage)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(sqlite|sqlite-wal|sqlite-shm|sql|log|md|sample\.php)$ - [F,L]

  # Clean URLs: anything that isn't a real file or folder goes to the router
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|sql|log|md)$">
  Require all denied
</FilesMatch>
